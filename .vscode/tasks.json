			"command": "bash bin/poe_exec.sh init",
			"group": "build",
			"icon": {
				"id": "tools",
				"color": "terminal.ansiBlue"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
